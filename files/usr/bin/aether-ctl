#!/bin/sh
# aether-ctl — CLI management tool for Aether on OpenWrt
# Usage: aether-ctl {start|stop|restart|status|show|set|version|change-version|test|check-ip|check-tor|check-psiphon|update}

UCI="/sbin/uci"
PROG="/usr/bin/aether"
CFG="aether.main"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

log_info()  { echo -e "${GREEN}[+]${RESET} $*"; }
log_warn()  { echo -e "${YELLOW}[!]${RESET} $*"; }
log_err()   { echo -e "${RED}[-]${RESET} $*" >&2; }
log_key()   { printf "  ${CYAN}%-20s${RESET} %s\n" "$1:" "$2"; }

# Never quote the value in "uci set key=value" — quoting corrupts UCI.
uci_get() { $UCI get "$CFG.$1" 2>/dev/null; }
uci_set() { $UCI set "$CFG.$1=$2"; }

core_version() {
	$PROG --version 2>/dev/null | awk 'NR == 1 {
		for (i = 1; i <= NF; i++) {
			version = $i
			sub(/^v/, "", version)
			if (version ~ /^[0-9]+\.[0-9]+\.[0-9]+/) {
				print version
				exit
			}
		}
	}'
}

core_supports_v16() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 6 ] 2>/dev/null; }
}

core_supports_v17() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 7 ] 2>/dev/null; }
}

core_supports_v18() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 8 ] 2>/dev/null; }
}

core_supports_v19() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 9 ] 2>/dev/null; }
}

core_supports_v20() {
	local version="$1" major
	major="${version%%.*}"
	[ "$major" -ge 2 ] 2>/dev/null
}

core_supports_v21() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 2 ] 2>/dev/null ||
		{ [ "$major" -eq 2 ] 2>/dev/null && [ "$minor" -ge 1 ] 2>/dev/null; }
}

core_supports_v23() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 2 ] 2>/dev/null ||
		{ [ "$major" -eq 2 ] 2>/dev/null && [ "$minor" -ge 3 ] 2>/dev/null; }
}

# Automatic performance profile from total RAM:
# <256MB -> low, 256MB-768MB -> medium, >768MB -> high
select_perf_profile() {
	local total_kb
	total_kb="$(awk '/^MemTotal/ {print $2}' /proc/meminfo 2>/dev/null)"
	case "$total_kb" in
		''|*[!0-9]*) echo "low"; return ;;
	esac
	if [ "$total_kb" -lt 262144 ]; then
		echo "low"
	elif [ "$total_kb" -lt 786432 ]; then
		echo "medium"
	else
		echo "high"
	fi
}

# Mask credentials embedded in an upstream proxy URL:
# socks5://user:pass@host:1080 -> socks5://***@host:1080
redact_url() {
	local url="$1" prefix="" rest
	case "$url" in
		*@*) ;;
		*) echo "$url"; return ;;
	esac
	rest="${url##*@}"
	case "$url" in
		*://*) prefix="${url%%://*}://" ;;
	esac
	echo "${prefix}***@${rest}"
}

core_is_v15() {
	local version
	version="$(core_version)"
	[ -n "$version" ] && ! core_supports_v16 "$version"
}

is_running() {
	local running
	running=$(ubus call service list '{"name":"aether"}' 2>/dev/null |
		jsonfilter -e '@.aether.instances.core.running' 2>/dev/null)
	[ "$running" = "true" ]
}

service_pid() {
	ubus call service list '{"name":"aether"}' 2>/dev/null |
		jsonfilter -e '@.aether.instances.core.pid' 2>/dev/null
}

wait_running() {
	# Some BusyBox sleep builds reject fractional seconds ("invalid number").
	# Poll in whole seconds instead; total budget stays 10 s.
	local i=0
	while [ $i -lt 10 ] && ! is_running; do
		sleep 1
		i=$((i + 1))
	done
	is_running
}

do_start() {
	if is_running; then
		log_warn "Aether is already running (PID $(service_pid))"
		return 0
	fi
	/etc/init.d/aether start
	if wait_running; then
		log_info "Aether started (PID $(service_pid))"
	else
		log_err "Aether failed to start. Check: logread -e aether"
		/etc/init.d/aether status 2>/dev/null
		return 1
	fi
}

do_stop() {
	if ! is_running; then
		log_warn "Aether is not running"
		return 0
	fi
	/etc/init.d/aether stop
	log_info "Aether stopped"
}

do_restart() {
	log_info "Restarting Aether..."
	/etc/init.d/aether restart
	if wait_running; then
		log_info "Aether restarted (PID $(service_pid))"
	else
		log_err "Aether failed to restart"
		return 1
	fi
}

do_status() {
	echo ""
	echo "=== Aether Status ==="
	if is_running; then
		log_key "State" "running"
		log_key "PID" "$(service_pid)"
	else
		log_key "State" "stopped"
	fi
	echo ""
	echo "=== Configuration ==="
	do_show
	echo ""
	echo "=== Binary ==="
	log_key "Path" "$PROG"
	if [ -x "$PROG" ]; then
		log_key "Version" "$($PROG --version 2>&1)"
	else
		log_key "Status" "not installed"
	fi
	echo ""
}

do_show() {
	local enabled=$(uci_get enabled)
	local protocol=$(uci_get protocol)
	local socks_listen=$(uci_get socks_listen)
	local http_proxy=$(uci_get http_proxy)
	local upstream_proxy=$(uci_get upstream_proxy)
	local scan_mode=$(uci_get scan_mode)
	local ip_version=$(uci_get ip_version)
	local obfuscation_profile=$(uci_get obfuscation_profile)
	local stored_obfuscation
	local http2_mode=$(uci_get http2_mode)
	local h2_peer=$(uci_get h2_peer)
	local fragment_tls=$(uci_get fragment_tls)
	local peer=$(uci_get peer)
	local keepalive=$(uci_get keepalive)
	local reconnect_secs=$(uci_get reconnect_secs)
	local validate_secs=$(uci_get validate_secs)
	local startup_secs=$(uci_get startup_secs)
	local quick_reconnect=$(uci_get quick_reconnect)
	local no_data_check=$(uci_get no_data_check)
	local no_profile_retry=$(uci_get no_profile_retry)
	local log_level=$(uci_get log_level)
	local team=$(uci_get team)
	local access_id=$(uci_get access_id)
	local access_secret=$(uci_get access_secret)
	local access_token=$(uci_get access_token)
	local gateway=$(uci_get gateway)
	local watchdog_enabled=$(uci_get watchdog_enabled)
	local installed_version=$(core_version)
	local supports_v16=0
	[ -n "$installed_version" ] && core_supports_v16 "$installed_version" && supports_v16=1
	local supports_v17=0
	[ -n "$installed_version" ] && core_supports_v17 "$installed_version" && supports_v17=1
	local supports_v18=0
	[ -n "$installed_version" ] && core_supports_v18 "$installed_version" && supports_v18=1
	local supports_v19=0
	[ -n "$installed_version" ] && core_supports_v19 "$installed_version" && supports_v19=1
	local perf_profile=$(uci_get perf_profile)
	local wiw_outer=$(uci_get wiw_outer)
	local wiw_inner=$(uci_get wiw_inner)
	local mim_outer=$(uci_get mim_outer)
	local mim_inner=$(uci_get mim_inner)
	local mim_peers=$(uci_get mim_peers)
	local quic_v2=$(uci_get quic_v2)
	local ech=$(uci_get ech)
	local tor_mode=$(uci_get tor_mode)
	local supports_v20=0
	[ -n "$installed_version" ] && core_supports_v20 "$installed_version" && supports_v20=1
	local tor_http=$(uci_get tor_http)
	local tor_relays=$(uci_get tor_relays)
	local psiphon_mode=$(uci_get psiphon_mode)
	local psiphon_bind=$(uci_get psiphon_bind)
	local exit_loc=$(uci_get exit_loc)
	local stats=$(uci_get stats)
	local gool_carrier=$(uci_get gool_carrier)
	local gool_peer=$(uci_get gool_peer)
	local supports_v21=0
	[ -n "$installed_version" ] && core_supports_v21 "$installed_version" && supports_v21=1
	local supports_v23=0
	[ -n "$installed_version" ] && core_supports_v23 "$installed_version" && supports_v23=1

	log_key "Boot Enabled" "$([ "$enabled" = "1" ] && echo "yes" || echo "no")"
	log_key "Core Version" "${installed_version:-unknown}"
	log_key "Protocol" "${protocol:-masque}"
	log_key "SOCKS Listen" "${socks_listen:-0.0.0.0:1819}"
	if [ "$supports_v16" -eq 1 ]; then
		[ -n "$http_proxy" ] && log_key "HTTP Proxy" "$http_proxy"
	else
		[ -n "$http_proxy" ] && log_key "HTTP Proxy" "stored (inactive on core v${installed_version:-unknown})"
	fi
	if [ "$supports_v17" -eq 1 ]; then
		[ -n "$upstream_proxy" ] && log_key "Upstream Proxy" "$(redact_url "$upstream_proxy")"
	else
		[ -n "$upstream_proxy" ] && log_key "Upstream Proxy" "stored (inactive on core v${installed_version:-unknown})"
	fi
	log_key "Scan Mode" "${scan_mode:-balanced}"
	log_key "IP Version" "${ip_version:-ipv4}"
	# Show the effective profile: init.d remaps anything outside the
	# protocol family (masque/mim: firewall/gfw/off; wg/gool: balanced/aggressive/light/off).
	stored_obfuscation="$obfuscation_profile"
	case "${protocol:-masque}" in
		wg|gool)
			case "$obfuscation_profile" in balanced|aggressive|light|off) ;; *) obfuscation_profile=balanced ;; esac ;;
		*)
			case "$obfuscation_profile" in firewall|gfw|off) ;; *) obfuscation_profile=firewall ;; esac ;;
	esac
	if [ -n "$stored_obfuscation" ] && [ "$stored_obfuscation" != "$obfuscation_profile" ]; then
		log_key "Obfuscation" "$obfuscation_profile (stored $stored_obfuscation)"
	else
		log_key "Obfuscation" "${obfuscation_profile:-firewall}"
	fi
	log_key "HTTP/2" "$([ "$http2_mode" = "1" ] && echo "on" || echo "off")"
	[ -n "$h2_peer" ] && log_key "H2 Peer" "$h2_peer"
	log_key "TLS Fragment" "$([ "$fragment_tls" = "1" ] && echo "on" || echo "off")"
	log_key "Peer" "${peer:-auto-scan}"
	log_key "Keepalive" "${keepalive:-5}s"
	log_key "Reconnect" "${reconnect_secs:-2}s"
	log_key "Validate" "${validate_secs:-10}s"
	if [ "$supports_v16" -eq 1 ]; then
		[ "${protocol:-masque}" = "masque" ] && log_key "Startup Deadline" "${startup_secs:-30}s"
	else
		log_key "Startup Deadline" "inactive on core v${installed_version:-unknown}"
	fi
	log_key "Quick Reconnect" "$([ "$quick_reconnect" = "1" ] && echo "on" || echo "off")"
	log_key "No Data Check" "$([ "$no_data_check" = "1" ] && echo "on" || echo "off")"
	[ "${protocol:-masque}" != "masque" ] &&
		log_key "Profile Retry" "$([ "$no_profile_retry" = "1" ] && echo "off" || echo "on")"
	if [ "$supports_v16" -eq 1 ]; then
		log_key "Log Level" "${log_level:-info}"
	else
		log_key "Log Level" "inactive on core v${installed_version:-unknown}"
	fi
	if [ "$supports_v18" -eq 1 ]; then
		log_key "Perf Profile" "${perf_profile:-low}"
	else
		log_key "Perf Profile" "inactive on core v${installed_version:-unknown}"
	fi
	if [ "${protocol:-masque}" = "gool" ]; then
		if [ "$supports_v23" -eq 1 ]; then
			log_key "gool Carrier" "${gool_carrier:-masque}"
			if [ "${gool_carrier:-masque}" = "classic" ]; then
				if [ "$supports_v19" -eq 1 ]; then
					log_key "gool Outer Hop" "${wiw_outer:-auto-scan}"
					log_key "gool Inner Hop" "${wiw_inner:-auto-scan}"
				fi
			elif [ -n "$gool_peer" ]; then
				log_key "gool Inner Peer" "$gool_peer"
			fi
		elif [ "$supports_v19" -eq 1 ]; then
			log_key "gool Outer Hop" "${wiw_outer:-auto-scan}"
			log_key "gool Inner Hop" "${wiw_inner:-auto-scan}"
		else
			log_key "gool Hops" "inactive on core v${installed_version:-unknown}"
		fi
	fi
	if [ "$supports_v19" -eq 1 ] && [ -n "$ech" ]; then
		log_key "ECH" "$ech"
	fi
	if [ -n "$exit_loc" ]; then
		if [ "$supports_v21" -eq 1 ]; then
			log_key "Exit Location" "$exit_loc"
		else
			log_key "Exit Location" "stored (inactive on core v${installed_version:-unknown})"
		fi
	fi
	if [ "$stats" = "1" ]; then
		if [ "$supports_v21" -eq 1 ]; then
			log_key "Traffic Stats" "on"
		else
			log_key "Traffic Stats" "stored (inactive on core v${installed_version:-unknown})"
		fi
	fi
	if [ "${protocol:-masque}" = "mim" ]; then
		if [ "$supports_v20" -eq 1 ]; then
			log_key "MIM Outer Hop" "${mim_outer:-auto-scan}"
			log_key "MIM Inner Hop" "${mim_inner:-auto-scan}"
			[ -n "$mim_peers" ] && log_key "MIM Peers" "$mim_peers"
		else
			log_key "MIM" "inactive on core v${installed_version:-unknown}"
		fi
	fi
	if [ "$supports_v20" -eq 1 ]; then
		log_key "QUIC v2 Opener" "$([ "$quic_v2" = "0" ] && echo "off" || echo "on")"
		log_key "Tor" "${tor_mode:-off}"
		if [ "$supports_v21" -eq 1 ]; then
			case "$tor_mode" in tunnel|reverse|only)
				[ -n "$tor_http" ] && log_key "Tor HTTP Proxy" "$tor_http"
				[ -n "$tor_relays" ] && [ "$tor_relays" != "auto" ] &&
					log_key "Tor Relays" "$tor_relays"
				;;
			esac
		fi
	fi
	if [ "$supports_v21" -eq 1 ]; then
		log_key "Psiphon" "${psiphon_mode:-off}"
		case "$psiphon_mode" in
			tunnel|reverse) log_key "Psiphon Listen" "${psiphon_bind:-127.0.0.1:1821}" ;;
		esac
	elif [ -n "$psiphon_mode" ] && [ "$psiphon_mode" != "off" ]; then
		log_key "Psiphon" "stored (inactive on core v${installed_version:-unknown})"
	fi
	log_key "Zero Trust Team" "${team:-disabled}"
	if [ -n "$team" ]; then
		log_key "Access Client ID" "$([ -n "$access_id" ] && echo "configured" || echo "missing")"
		log_key "Access Secret" "$([ -n "$access_secret" ] && echo "configured (redacted)" || echo "missing")"
		log_key "Access Token" "$([ -n "$access_token" ] && echo "configured (redacted)" || echo "missing")"
		log_key "Gateway Proxy" "$([ "$gateway" = "1" ] && echo "on" || echo "off")"
	fi
	log_key "Data Watchdog" "$([ "$watchdog_enabled" = "0" ] && echo "off" || echo "on")"
}

# In manual command mode the running listener addresses come from
# custom_command, not from UCI. manual_opt prints the value of a flag
# (space or = form) found in custom_command, or nothing.
manual_opt() {
	local args flag w prev val
	args="$1"
	flag="$2"
	prev=""
	val=""
	for w in $args; do
		if [ -n "$prev" ]; then
			val="$w"
			break
		fi
		case "$w" in
			"$flag") prev=1 ;;
			"$flag="*) val="${w#*=}" ;;
		esac
	done
	echo "$val"
}

# Prints 1 when custom_command carries any Tor flag, else 0.
manual_has_tor() {
	case " $1 " in
		*" --tor "*|*" --tor-only "*|*" --tor-reverse "*) echo 1 ;;
		*) echo 0 ;;
	esac
}

# Prints 1 when custom_command carries any Psiphon flag, else 0.
manual_has_psiphon() {
	case " $1 " in
		*" --psiphon "*|*" --psiphon-only "*|*" --psiphon-reverse "*) echo 1 ;;
		*) echo 0 ;;
	esac
}

do_test() {
	local target="$1"
	if [ -z "$target" ]; then
		echo "Usage: aether-ctl test <host>"
		echo ""
		echo "Examples:"
		echo "  aether-ctl test google.com"
		echo "  aether-ctl test youtube.com"
		echo "  aether-ctl test github.com"
		return 1
	fi

	# Always use 127.0.0.1 for local test even if UCI has 0.0.0.0.
	# In manual mode the running bind comes from custom_command.
	local socks mode custom
	socks=""
	mode=$(uci_get command_mode)
	if [ "$mode" = "manual" ]; then
		custom=$(uci_get custom_command)
		socks=$(manual_opt "$custom" --bind)
		[ -z "$socks" ] && socks=$(manual_opt "$custom" --socks)
	fi
	[ -z "$socks" ] && socks=$(uci_get socks_listen)
	socks=$(echo "$socks" | sed 's/0\.0\.0\.0/127.0.0.1/')
	[ -z "$socks" ] && socks="127.0.0.1:1819"

	# Check curl is installed
	if ! command -v curl >/dev/null 2>&1; then
		if command -v apk >/dev/null 2>&1; then
			log_err "curl not found. Install with: apk add curl"
		elif command -v opkg >/dev/null 2>&1; then
			log_err "curl not found. Install with: opkg install curl"
		else
			log_err "curl not found. Install curl using your package manager."
		fi
		return 1
	fi

	log_info "Testing $target via SOCKS5 ($socks)..."

	# Use --socks5-hostname for DNS resolution through proxy
	# curl -w gives us %{time_total} in seconds (float) for precise timing
	local result http_code time_ms
	result=$(curl -s -o /dev/null \
		-w "%{http_code} %{time_total}" \
		--socks5-hostname "$socks" \
		--connect-timeout 10 --max-time 15 \
		"https://$target" 2>/dev/null)
	local exit_code=$?

	if [ $exit_code -ne 0 ] || [ -z "$result" ]; then
		# Will fall through to HTTP fallback below
		http_code=""
		time_ms="15000"
	else
		http_code=$(echo "$result" | awk '{print $1}')
		local time_s=$(echo "$result" | awk '{print $2}')
		time_ms=$(awk -v t="$time_s" 'BEGIN{printf "%.0f", t*1000}')
	fi

	if [ -n "$http_code" ] && [ "$http_code" != "000" ]; then
		log_info "OK ${http_code} ${time_ms}ms"
	else
		# Try http as fallback
		result=$(curl -s -o /dev/null \
			-w "%{http_code} %{time_total}" \
			--socks5-hostname "$socks" \
			--connect-timeout 10 --max-time 15 \
			"http://$target" 2>/dev/null)
		exit_code=$?

		if [ $exit_code -ne 0 ] || [ -z "$result" ]; then
			log_err "FAILED 15000ms"
			return 1
		fi

		http_code=$(echo "$result" | awk '{print $1}')
		local time_s2=$(echo "$result" | awk '{print $2}')
		time_ms=$(awk -v t="$time_s2" 'BEGIN{printf "%.0f", t*1000}')

		if [ -n "$http_code" ] && [ "$http_code" != "000" ]; then
			log_info "OK ${http_code} ${time_ms}ms"
		else
			log_err "FAILED ${time_ms}ms"
			return 1
		fi
	fi
}
do_check_ip() {
	# Always use 127.0.0.1 for local test even if UCI has 0.0.0.0.
	# In manual mode the running bind comes from custom_command.
	local socks mode custom
	socks=""
	mode=$(uci_get command_mode)
	if [ "$mode" = "manual" ]; then
		custom=$(uci_get custom_command)
		socks=$(manual_opt "$custom" --bind)
		[ -z "$socks" ] && socks=$(manual_opt "$custom" --socks)
	fi
	[ -z "$socks" ] && socks=$(uci_get socks_listen)
	socks=$(echo "$socks" | sed 's/0\.0\.0\.0/127.0.0.1/')
	[ -z "$socks" ] && socks="127.0.0.1:1819"

	# Check curl is installed
	if ! command -v curl >/dev/null 2>&1; then
		if command -v apk >/dev/null 2>&1; then
			log_err "curl not found. Install with: apk add curl"
		elif command -v opkg >/dev/null 2>&1; then
			log_err "curl not found. Install with: opkg install curl"
		else
			log_err "curl not found. Install curl using your package manager."
		fi
		return 1
	fi

	log_info "Checking public IP via SOCKS5 ($socks)..."

	local raw exit_code meta body http_code time_s time_ms ip country

	# Provider 1: ifconfig.co/json (Cloudflare-hosted, full country name)
	raw=$(curl -s \
		-w "\n%{http_code} %{time_total}" \
		--socks5-hostname "$socks" \
		--connect-timeout 8 --max-time 12 \
		"https://ifconfig.co/json" 2>/dev/null)
	exit_code=$?

	if [ $exit_code -eq 0 ] && [ -n "$raw" ]; then
		meta=$(echo "$raw" | tail -n 1)
		body=$(echo "$raw" | sed '$d')
		http_code=$(echo "$meta" | awk '{print $1}')
		time_s=$(echo "$meta" | awk '{print $2}')
		time_ms=$(awk -v t="$time_s" 'BEGIN{printf "%.0f", t*1000}')
		[ -z "$time_ms" ] && time_ms="0"

		if [ "$http_code" = "200" ] && [ -n "$body" ]; then
			if command -v jsonfilter >/dev/null 2>&1; then
				ip=$(printf '%s' "$body" | jsonfilter -e '@.ip' 2>/dev/null)
				country=$(printf '%s' "$body" | jsonfilter -e '@.country' 2>/dev/null)
			fi
			[ -z "$ip" ] && ip=$(printf '%s' "$body" | sed -n 's/.*"ip":[[:space:]]*"\([^"]*\)".*/\1/p')
			[ -z "$country" ] && country=$(printf '%s' "$body" | sed -n 's/.*"country":[[:space:]]*"\([^"]*\)".*/\1/p')

			if [ -n "$ip" ]; then
				if [ -n "$country" ]; then
					log_info "IP: $ip ($country) ${time_ms}ms"
				else
					log_info "IP: $ip ${time_ms}ms"
				fi
				return 0
			fi
		fi
	fi

	# Provider 2: ipwho.is (fallback)
	raw=$(curl -s \
		-w "\n%{http_code} %{time_total}" \
		--socks5-hostname "$socks" \
		--connect-timeout 8 --max-time 12 \
		"https://ipwho.is/" 2>/dev/null)
	exit_code=$?

	if [ $exit_code -eq 0 ] && [ -n "$raw" ]; then
		meta=$(echo "$raw" | tail -n 1)
		body=$(echo "$raw" | sed '$d')
		http_code=$(echo "$meta" | awk '{print $1}')
		time_s=$(echo "$meta" | awk '{print $2}')
		time_ms=$(awk -v t="$time_s" 'BEGIN{printf "%.0f", t*1000}')
		[ -z "$time_ms" ] && time_ms="0"

		if [ "$http_code" = "200" ] && [ -n "$body" ]; then
			ip="" country=""
			if command -v jsonfilter >/dev/null 2>&1; then
				ip=$(printf '%s' "$body" | jsonfilter -e '@.ip' 2>/dev/null)
				country=$(printf '%s' "$body" | jsonfilter -e '@.country' 2>/dev/null)
			fi
			[ -z "$ip" ] && ip=$(printf '%s' "$body" | sed -n 's/.*"ip":[[:space:]]*"\([^"]*\)".*/\1/p')
			[ -z "$country" ] && country=$(printf '%s' "$body" | sed -n 's/.*"country":[[:space:]]*"\([^"]*\)".*/\1/p')

			if [ -n "$ip" ]; then
				if [ -n "$country" ]; then
					log_info "IP: $ip ($country) ${time_ms}ms"
				else
					log_info "IP: $ip ${time_ms}ms"
				fi
				return 0
			fi
		fi
	fi

	# Provider 3: cloudflare.com/cdn-cgi/trace (native Cloudflare edge)
	raw=$(curl -s \
		-w "\n%{http_code} %{time_total}" \
		--socks5-hostname "$socks" \
		--connect-timeout 8 --max-time 12 \
		"https://cloudflare.com/cdn-cgi/trace" 2>/dev/null)
	exit_code=$?

	if [ $exit_code -eq 0 ] && [ -n "$raw" ]; then
		meta=$(echo "$raw" | tail -n 1)
		body=$(echo "$raw" | sed '$d')
		http_code=$(echo "$meta" | awk '{print $1}')
		time_s=$(echo "$meta" | awk '{print $2}')
		time_ms=$(awk -v t="$time_s" 'BEGIN{printf "%.0f", t*1000}')
		[ -z "$time_ms" ] && time_ms="0"

		if [ "$http_code" = "200" ] && [ -n "$body" ]; then
			ip=$(printf '%s\n' "$body" | awk -F= '$1=="ip"{print $2}')
			country=$(printf '%s\n' "$body" | awk -F= '$1=="loc"{print $2}')

			if [ -n "$ip" ]; then
				if [ -n "$country" ]; then
					log_info "IP: $ip ($country) ${time_ms}ms"
				else
					log_info "IP: $ip ${time_ms}ms"
				fi
				return 0
			fi
		fi
	fi

	log_err "FAILED ${time_ms:-15000}ms"
	return 1
}

do_check_tor() {
	# Tor exit check via the Tor SOCKS listener (default 127.0.0.1:1820).
	# In tor-only mode the main SOCKS listener itself is Tor.
	local tor_mode socks installed_version mode custom
	local raw exit_code meta body http_code time_s time_ms ip istor
	installed_version="$(core_version)"
	if [ -z "$installed_version" ] || ! core_supports_v20 "$installed_version"; then
		log_err "Tor requires Aether core v2.0.0 or newer (installed: ${installed_version:-unknown})"
		return 1
	fi
	mode=$(uci_get command_mode)
	if [ "$mode" = "manual" ]; then
		custom=$(uci_get custom_command)
		if [ "$(manual_has_tor "$custom")" != "1" ]; then
			log_err "Tor not in custom_command (add --tor --tor-bind 127.0.0.1:1820 or switch to generated mode)"
			return 1
		fi
		case " $custom " in
			*" --tor-only "*) socks=$(manual_opt "$custom" --bind) ;;
			*) socks=$(manual_opt "$custom" --tor-bind) ;;
		esac
	else
		tor_mode=$(uci_get tor_mode)
		case "$tor_mode" in
			tunnel|reverse|only) ;;
			*)
				log_err "Tor is off (tor_mode=${tor_mode:-off}). Enable with: aether-ctl set tor_mode tunnel"
				return 1 ;;
		esac
		if [ "$tor_mode" = "only" ]; then
			socks=$(uci_get socks_listen)
		else
			socks=$(uci_get tor_bind)
		fi
	fi
	# Always use 127.0.0.1 for local test even if UCI has 0.0.0.0
	socks=$(echo "$socks" | sed 's/0\.0\.0\.0/127.0.0.1/')
	[ -z "$socks" ] && socks="127.0.0.1:1820"

	if ! command -v curl >/dev/null 2>&1; then
		log_err "curl not found. Install curl using your package manager."
		return 1
	fi

	log_info "Checking Tor exit via SOCKS5 ($socks)..."

	# Bounded well under the uhttpd ubus RPC timeout so the LuCI button
	# reports FAILED instead of a transport Error on slow circuits.
	raw=$(curl -s \
		-w "\n%{http_code} %{time_total}" \
		--socks5-hostname "$socks" \
		--connect-timeout 8 --max-time 22 \
		"https://check.torproject.org/api/ip" 2>/dev/null)
	exit_code=$?

	if [ $exit_code -eq 0 ] && [ -n "$raw" ]; then
		meta=$(echo "$raw" | tail -n 1)
		body=$(echo "$raw" | sed '$d')
		http_code=$(echo "$meta" | awk '{print $1}')
		time_s=$(echo "$meta" | awk '{print $2}')
		time_ms=$(awk -v t="$time_s" 'BEGIN{printf "%.0f", t*1000}')
		[ -z "$time_ms" ] && time_ms="0"

		if [ "$http_code" = "200" ] && [ -n "$body" ]; then
			if command -v jsonfilter >/dev/null 2>&1; then
				istor=$(printf '%s' "$body" | jsonfilter -e '@.IsTor' 2>/dev/null)
				ip=$(printf '%s' "$body" | jsonfilter -e '@.IP' 2>/dev/null)
			fi
			[ -z "$istor" ] && istor=$(printf '%s' "$body" | sed -n 's/.*"IsTor":[[:space:]]*\([^,}]*\).*/\1/p' | tr 'A-Z' 'a-z')
			[ -z "$ip" ] && ip=$(printf '%s' "$body" | sed -n 's/.*"IP":[[:space:]]*"\([^"]*\)".*/\1/p')

			if [ -n "$ip" ]; then
				case "$istor" in
					true|1) log_info "Tor: true IP: $ip ${time_ms}ms" ;;
					*) log_info "Tor: false IP: $ip ${time_ms}ms" ;;
				esac
				return 0
			fi
		fi
	fi

	log_err "FAILED ${time_ms:-22000}ms"
	return 1
}

do_check_psiphon() {
	# Psiphon exit check via the Psiphon SOCKS listener (default 127.0.0.1:1821).
	# In psiphon-only mode the main SOCKS listener itself is Psiphon.
	local psiphon_mode socks installed_version mode custom
	local raw exit_code meta body http_code time_s time_ms ip country
	installed_version="$(core_version)"
	if [ -z "$installed_version" ] || ! core_supports_v21 "$installed_version"; then
		log_err "Psiphon requires Aether core v2.1.0 or newer (installed: ${installed_version:-unknown})"
		return 1
	fi
	mode=$(uci_get command_mode)
	if [ "$mode" = "manual" ]; then
		custom=$(uci_get custom_command)
		if [ "$(manual_has_psiphon "$custom")" != "1" ]; then
			log_err "Psiphon not in custom_command (add --psiphon --psiphon-bind 127.0.0.1:1821 or switch to generated mode)"
			return 1
		fi
		case " $custom " in
			*" --psiphon-only "*) socks=$(manual_opt "$custom" --bind) ;;
			*) socks=$(manual_opt "$custom" --psiphon-bind) ;;
		esac
	else
		psiphon_mode=$(uci_get psiphon_mode)
		case "$psiphon_mode" in
			tunnel|reverse|only) ;;
			*)
				log_err "Psiphon is off (psiphon_mode=${psiphon_mode:-off}). Enable with: aether-ctl set psiphon_mode tunnel"
				return 1 ;;
		esac
		if [ "$psiphon_mode" = "only" ]; then
			socks=$(uci_get socks_listen)
		else
			socks=$(uci_get psiphon_bind)
		fi
	fi
	# Always use 127.0.0.1 for local test even if UCI has 0.0.0.0
	socks=$(echo "$socks" | sed 's/0\.0\.0\.0/127.0.0.1/')
	[ -z "$socks" ] && socks="127.0.0.1:1821"

	if ! command -v curl >/dev/null 2>&1; then
		log_err "curl not found. Install curl using your package manager."
		return 1
	fi

	log_info "Checking Psiphon exit via SOCKS5 ($socks)..."

	# Bounded under the uhttpd ubus RPC timeout like the Tor check; a fresh
	# Psiphon circuit can be slow on first use.
	raw=$(curl -s \
		-w "\n%{http_code} %{time_total}" \
		--socks5-hostname "$socks" \
		--connect-timeout 8 --max-time 22 \
		"https://ifconfig.co/json" 2>/dev/null)
	exit_code=$?

	if [ $exit_code -eq 0 ] && [ -n "$raw" ]; then
		meta=$(echo "$raw" | tail -n 1)
		body=$(echo "$raw" | sed '$d')
		http_code=$(echo "$meta" | awk '{print $1}')
		time_s=$(echo "$meta" | awk '{print $2}')
		time_ms=$(awk -v t="$time_s" 'BEGIN{printf "%.0f", t*1000}')
		[ -z "$time_ms" ] && time_ms="0"

		if [ "$http_code" = "200" ] && [ -n "$body" ]; then
			if command -v jsonfilter >/dev/null 2>&1; then
				ip=$(printf '%s' "$body" | jsonfilter -e '@.ip' 2>/dev/null)
				country=$(printf '%s' "$body" | jsonfilter -e '@.country' 2>/dev/null)
			fi
			[ -z "$ip" ] && ip=$(printf '%s' "$body" | sed -n 's/.*"ip":[[:space:]]*"\([^"]*\)".*/\1/p')
			[ -z "$country" ] && country=$(printf '%s' "$body" | sed -n 's/.*"country":[[:space:]]*"\([^"]*\)".*/\1/p')

			if [ -n "$ip" ]; then
				if [ -n "$country" ]; then
					log_info "Psiphon: $ip ($country) ${time_ms}ms"
				else
					log_info "Psiphon: $ip ${time_ms}ms"
				fi
				return 0
			fi
		fi
	fi

	log_err "FAILED ${time_ms:-22000}ms"
	return 1
}

do_set() {
	local key="$1"
	local value="$2"
	local installed_version proto_tor tor_proto
	installed_version="$(core_version)"

	if [ -z "$key" ] || [ -z "$value" ]; then
		echo "Usage: aether-ctl set <option> <value>"
		echo ""
		echo "Options:"
		echo "  enabled             yes/no"
		echo "  protocol            masque/wg/gool/mim (mim requires v2.0.0+)"
		echo "  socks_listen        ip:port"
		echo "  http_proxy          ip:port (optional HTTP CONNECT proxy)"
		echo "  upstream_proxy      proxy URL (v1.7+ upstream chaining; e.g. socks5://[user:pass@]host:port)"
		echo "  scan_mode           turbo/balanced/thorough/stealth/ironclad (verified on v2.1+)"
		echo "  ip_version          ipv4/ipv6/both"
		echo "  obfuscation_profile firewall/gfw/balanced/aggressive/light/off"
		echo "  http2_mode          0/1"
		echo "  h2_peer             ip:port (for h2 mode)"
		echo "  fragment_tls        0/1"
		echo "  peer                ip:port (empty for auto-scan)"
		echo "  keepalive           seconds"
		echo "  reconnect_secs      seconds"
		echo "  validate_secs       seconds"
		echo "  startup_secs        seconds (MASQUE only)"
		echo "  quick_reconnect     0/1"
		echo "  no_data_check       0/1"
		echo "  no_profile_retry    0/1 (WireGuard/gool only)"
		echo "  log_level           info/debug/warn/error"
		echo "  team                Zero Trust team name"
		echo "  access_id           service-token client ID"
		echo "  access_secret       service-token secret (redacted in output)"
		echo "  access_token        existing Zero Trust token (redacted in output)"
		echo "  gateway             0/1"
		echo "  watchdog_enabled    0/1"
		echo "  watchdog_interval   seconds"
		echo "  watchdog_failures   failures before recovery"
		echo "  perf_profile        low/medium/high (v1.8+; or use auto-perf)"
		echo "  wiw_outer           ip:port (gool outer hop, v1.9+; 'auto' clears)"
		echo "  wiw_inner           ip:port (gool inner hop, v1.9+; 'auto' clears)"
		echo "  mim_outer|mim_inner ip:port (MASQUE-in-MASQUE hops, v2.0.0+; 'auto' clears)"
		echo "  mim_peers           outer[,inner] ip:port values (v2.0.0+; 'auto' clears)"
		echo "  quic_v2             0/1 (MASQUE/MIM, v2.0.0+)"
		echo "  ech                 auto or base64 ECH config (v1.9+)"
		echo "  tor_mode            off/tunnel/reverse/only (v2.0.0+)"
		echo "  tor_bind            ip:port (v2.0.0+)"
		echo "  tor_dir             state directory path (v2.0.0+)"
		echo "  tor_bridges         auto/on/off (v2.0.0+)"
		echo "  tor_http            ip:port, extra Tor HTTP/CONNECT proxy (v2.1+)"
		echo "  tor_relays          auto/only/off or a relay count (v2.1+)"
		echo "  psiphon_mode        off/tunnel/reverse/only (v2.1+)"
		echo "  psiphon_bind        ip:port (v2.1+)"
		echo "  psiphon_http        ip:port, extra Psiphon HTTP/CONNECT proxy (v2.1+)"
		echo "  psiphon_region      two-letter exit country, e.g. DE (v2.1+)"
		echo "  psiphon_shape       auto/cdn/direct fronting (v2.1+)"
		echo "  exit_loc            exit-country policy, e.g. '!IR,AZ,RU' or 'DE,SE' (v2.1+; 'auto' clears)"
		echo "  stats               0/1 log traffic totals (v2.1+)"
		echo "  gool_carrier        masque/classic gool carrier (v2.3.0+)"
		echo "  gool_peer           ip:port inner endpoint for MASQUE-carried gool (v2.3.0+)"
		echo "  command_mode        generated/manual (custom core command line)"
		echo "  custom_command      manual arguments, space-separated ('auto' clears)"
		return 1
	fi

	if core_is_v15; then
		case "$key" in
			http_proxy|startup_secs|log_level)
				log_err "$key requires Aether core v1.6.0 or newer"
				return 1
				;;
		esac
	fi
	if [ -n "$installed_version" ] && ! core_supports_v18 "$installed_version"; then
		case "$key" in
			perf_profile)
				log_err "$key requires Aether core v1.8.0 or newer"
				return 1
				;;
		esac
	fi
	if [ -n "$installed_version" ] && ! core_supports_v19 "$installed_version"; then
		case "$key" in
			wiw_outer|wiw_inner|ech)
				log_err "$key requires Aether core v1.9.0 or newer"
				return 1
				;;
		esac
	fi
	if [ -n "$installed_version" ] && ! core_supports_v20 "$installed_version"; then
		case "$key" in
			mim_outer|mim_inner|mim_peers|quic_v2|tor_mode|tor_bind|tor_dir|tor_bridges)
				log_err "$key requires Aether core v2.0.0 or newer"
				return 1
				;;
		esac
	fi
	if [ -n "$installed_version" ] && ! core_supports_v21 "$installed_version"; then
		case "$key" in
			psiphon_mode|psiphon_bind|psiphon_http|psiphon_region|psiphon_shape|tor_http|tor_relays|exit_loc|stats)
				log_err "$key requires Aether core v2.1.0 or newer"
				return 1
				;;
		esac
	fi
	if [ -n "$installed_version" ] && ! core_supports_v23 "$installed_version"; then
		case "$key" in
			gool_carrier|gool_peer)
				log_err "$key requires Aether core v2.3.0 or newer"
				return 1
				;;
		esac
	fi

	case "$key" in
		enabled)
			case "$value" in
				yes|1|on|true)  value=1 ;;
				no|0|off|false) value=0 ;;
				*) log_err "Invalid value for enabled: $value (use yes/no)"; return 1 ;;
			esac ;;
		protocol)
			case "$value" in
				masque|wg|gool) ;;
				mim)
					[ -n "$installed_version" ] && core_supports_v20 "$installed_version" || {
						log_err "mim requires Aether core v2.0.0 or newer"
						return 1
					} ;;
				*) log_err "Invalid protocol: $value (use masque/wg/gool/mim)"; return 1 ;;
			esac
			if [ "$value" != "masque" ]; then
				proto_tor=$(uci_get tor_mode)
				if [ "$proto_tor" = "reverse" ]; then
					log_err "Tor reverse mode requires protocol masque (tor_mode=reverse is set). Change tor_mode first or use protocol masque."
					return 1
				fi
				proto_tor=$(uci_get psiphon_mode)
				if [ "$proto_tor" = "reverse" ]; then
					log_err "Psiphon reverse mode requires protocol masque (psiphon_mode=reverse is set). Change psiphon_mode first or use protocol masque."
					return 1
				fi
			fi ;;
		scan_mode)
			case "$value" in
				turbo|balanced|thorough|stealth|ironclad) ;;
				verified)
					[ -n "$installed_version" ] && core_supports_v21 "$installed_version" || {
						log_err "scan_mode verified requires Aether core v2.1.0 or newer"
						return 1
					} ;;
				*) log_err "Invalid scan_mode: $value (use turbo/balanced/thorough/verified/stealth/ironclad)"; return 1 ;;
			esac ;;
		ip_version)
			case "$value" in
				ipv4|ipv6|both) ;;
				*) log_err "Invalid ip_version: $value (use ipv4/ipv6/both)"; return 1 ;;
			esac ;;
		http2_mode|fragment_tls|quick_reconnect|no_data_check|no_profile_retry|gateway|watchdog_enabled|quic_v2)
			case "$value" in
				0|1|on|off|yes|no)
					case "$value" in
						on|yes) value=1 ;;
						off|no) value=0 ;;
					esac ;;
				*) log_err "Invalid value: $value (use 0/1)"; return 1 ;;
			esac ;;
		perf_profile)
			case "$value" in
				auto)
					value="$(select_perf_profile)"
					log_info "Auto-detected profile based on RAM: $value"
					;;
				low|medium|high) ;;
				*) log_err "Invalid perf_profile: $value (use low/medium/high or auto)"; return 1 ;;
			esac ;;
		wiw_outer|wiw_inner|mim_outer|mim_inner)
			case "$value" in
				auto) value="" ;;
				*.*:*) ;;
				*) log_err "Invalid value for $key: $value (use ip:port or auto)"; return 1 ;;
			esac ;;
		mim_peers)
			case "$value" in
				auto) value="" ;;
				*.*:*) ;;
				*) log_err "Invalid mim_peers: $value (use outer[,inner] ip:port values or auto)"; return 1 ;;
			esac ;;
		ech)
			case "$value" in
				auto|*[![:space:]]*) ;;
				*) log_err "Invalid ECH value: use auto or a base64 configuration"; return 1 ;;
			esac ;;
		tor_mode)
			case "$value" in off|tunnel|reverse|only) ;; *) log_err "Invalid tor_mode: use off/tunnel/reverse/only"; return 1 ;; esac
			if [ "$value" = "reverse" ]; then
				tor_proto=$(uci_get protocol)
				if [ "${tor_proto:-masque}" != "masque" ]; then
					log_err "Tor reverse mode requires protocol masque (current: $tor_proto). Set protocol first: aether-ctl set protocol masque"
					return 1
				fi
			fi ;;
		tor_bind)
			case "$value" in
				*.*:*) ;;
				*) log_err "Invalid tor_bind: $value (use ip:port)"; return 1 ;;
			esac ;;
		tor_dir)
			case "$value" in
				''|/*) ;;
				*) log_err "Invalid tor_dir: $value (use an absolute path)"; return 1 ;;
			esac ;;
		tor_bridges)
			case "$value" in auto|on|off) ;; *) log_err "Invalid tor_bridges: use auto/on/off"; return 1 ;; esac ;;
		tor_http|psiphon_bind|psiphon_http)
			case "$value" in
				*.*:*) ;;
				*) log_err "Invalid $key: $value (use ip:port)"; return 1 ;;
			esac ;;
		tor_relays)
			case "$value" in
				auto|only|off) ;;
				''|*[!0-9]*) log_err "Invalid tor_relays: $value (use auto/only/off or a relay count)"; return 1 ;;
			esac ;;
		psiphon_mode)
			case "$value" in off|tunnel|reverse|only) ;; *) log_err "Invalid psiphon_mode: use off/tunnel/reverse/only"; return 1 ;; esac
			if [ "$value" = "reverse" ]; then
				tor_proto=$(uci_get protocol)
				if [ "${tor_proto:-masque}" != "masque" ]; then
					log_err "Psiphon reverse mode requires protocol masque (current: $tor_proto). Set protocol first: aether-ctl set protocol masque"
					return 1
				fi
			fi ;;
		psiphon_region)
			case "$value" in
				auto) value="" ;;
				''|[[:alpha:]][[:alpha:]]) ;;
				*) log_err "Invalid psiphon_region: $value (use a two-letter country code, e.g. DE, or auto to clear)"; return 1 ;;
			esac ;;
		psiphon_shape)
			case "$value" in auto|cdn|direct) ;; *) log_err "Invalid psiphon_shape: use auto/cdn/direct"; return 1 ;; esac ;;
		exit_loc)
			case "$value" in
				auto) value="" ;;
				'') log_err "Empty exit_loc: use 'auto' to clear"; return 1 ;;
				*)
					echo "$value" | grep -Eq '^!?[A-Za-z]{2}(,!?[A-Za-z]{2})*$' || {
						log_err "Invalid exit_loc: $value (use '!IR,AZ,RU' to block or 'DE,SE' to allow only, or 'auto' to clear)"
						return 1
					} ;;
			esac ;;
		stats)
			case "$value" in
				0|1|on|off|yes|no)
					case "$value" in
						on|yes) value=1 ;;
						off|no) value=0 ;;
					esac ;;
				*) log_err "Invalid value: $value (use 0/1)"; return 1 ;;
			esac ;;
		gool_carrier)
			case "$value" in masque|classic) ;; *) log_err "Invalid gool_carrier: use masque/classic"; return 1 ;; esac ;;
		gool_peer)
			case "$value" in
				auto) value="" ;;
				*.*:*) ;;
				*) log_err "Invalid gool_peer: $value (use ip:port or auto)"; return 1 ;;
			esac ;;
		command_mode)
			case "$value" in generated|manual) ;; *) log_err "Invalid command_mode: use generated/manual"; return 1 ;; esac ;;
		custom_command)
			case "$value" in auto) value="" ;; '') log_err "Empty custom_command: use 'auto' to clear"; return 1 ;; esac ;;
		keepalive|reconnect_secs|validate_secs|startup_secs|watchdog_interval|watchdog_failures|watchdog_startup_grace|watchdog_cooldown)
			case "$value" in
				''|*[!0-9]*) log_err "Invalid numeric value: $value"; return 1 ;;
			esac ;;
		socks_listen|http_proxy|upstream_proxy|obfuscation_profile|h2_peer|fragment_size|fragment_delay|peer|log_level|team|access_id|access_secret|access_token) ;;
		*)
			log_err "Unknown configuration option: $key"
			return 1
			;;
	esac

	uci_set "$key" "$value"
	$UCI commit aether
	if [ "$key" = "enabled" ]; then
		if [ "$value" = "1" ]; then
			/etc/init.d/aether enable
		else
			/etc/init.d/aether disable
		fi
	fi
	if [ "$key" = "access_secret" ] || [ "$key" = "access_token" ]; then
		log_info "Set $key = (redacted)"
	elif [ "$key" = "upstream_proxy" ]; then
		log_info "Set $key = $(redact_url "$value")"
	else
		log_info "Set $key = $value"
	fi

	if is_running; then
		echo ""
		log_warn "Aether is running. Changes take effect on next restart."
		printf "Restart now? [y/N]: "
		read -r answer
		case "$answer" in
			y|Y|yes|YES) do_restart ;;
		esac
	fi
}

do_auto_perf() {
	local installed_version supports_v18=0
	installed_version="$(core_version)"
	[ -n "$installed_version" ] && core_supports_v18 "$installed_version" && supports_v18=1
	if [ "$supports_v18" -ne 1 ]; then
		log_err "perf_profile requires Aether core v1.8.0 or newer"
		return 1
	fi
	local prof
	prof="$(select_perf_profile)"
	uci_set "perf_profile" "$prof"
	$UCI commit aether
	log_info "Detected router RAM: set perf_profile = $prof"
	if is_running; then
		echo ""
		log_warn "Aether is running. Changes take effect on next restart."
		printf "Restart now? [y/N]: "
		read -r answer
		case "$answer" in
			y|Y|yes|YES) do_restart ;;
		esac
	fi
}

do_version() {
	if [ "${1:-}" = "change" ]; then
		shift
		do_change_version "$@"
		return $?
	fi
	if [ -x "$PROG" ]; then
		$PROG --version
	else
		log_err "Aether not installed at $PROG"
		return 1
	fi
}

do_change_version() {
	local target="${1:-}"
	[ -n "$target" ] || {
		log_err "Usage: aether-ctl change-version <vX.Y.Z> [installer options]"
		return 1
	}
	shift
	case "$target" in
		v[0-9]*.[0-9]*.[0-9]*)
			echo "$target" | grep -Eq '^v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$' || {
				log_err "Invalid core version: $target (expected vX.Y.Z)"
				return 1
			}
			;;
		*)
			log_err "Usage: aether-ctl change-version <vX.Y.Z> [installer options]"
			return 1
			;;
	esac
	if ! echo "$target" | awk -F '[v.]' '{ exit !($2 > 1 || ($2 == 1 && $3 >= 5)) }'; then
		log_err "Unsupported core version: $target (v1.5.0 or newer is required)"
		return 1
	fi
	do_update --version "$target" "$@"
}

do_update() {
	local raw_base="https://raw.githubusercontent.com/Rezayavarzade123/aether-openwrt-test-with-arena.ai/main"
	local tmpdir updater arg update_args

	if [ "$(id -u)" -ne 0 ]; then
		log_err "Run update as root."
		return 1
	fi

	update_args="$*"
	while [ "$#" -gt 0 ]; do
		arg="$1"
		case "$arg" in
			--start|--force-config|--no-curl|--non-interactive|--version=*) ;;
			--version)
				shift
				[ -n "${1:-}" ] || {
					log_err "--version requires a release tag"
					return 1
				}
				;;
			*)
				log_err "Unsupported update option: $arg"
				return 1
				;;
		esac
		shift
	done

	command -v wget >/dev/null 2>&1 || {
		log_err "wget is required to update"
		return 1
	}
	tmpdir=$(mktemp -d /tmp/aether-ctl-update.XXXXXX) || {
		log_err "Could not create temporary directory"
		return 1
	}
	trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM
	updater="$tmpdir/update.sh"
	log_info "Downloading current updater..."
	wget -4 -T 30 -O "$updater" "$raw_base/update.sh" || {
		log_err "Failed to download updater"
		return 1
	}
	[ -s "$updater" ] && grep -q 'Aether OpenWrt Client' "$updater" || {
		log_err "Downloaded updater is empty or invalid"
		return 1
	}
	chmod 700 "$updater" || return 1
	# Arguments are checked above; intentional splitting preserves their shape.
	# shellcheck disable=SC2086
	"$updater" $update_args
}

do_log() {
	local lines="${1:-50}"
	echo "=== Aether Logs (last $lines lines) ==="
	echo ""
	logread -e aether -l "$lines" 2>/dev/null
	if [ $? -ne 0 ] || [ -z "$(logread -e aether -l 1 2>/dev/null)" ]; then
		log_warn "No Aether logs found. Service may not have run yet."
	fi
	echo ""
	echo "Tip: use 'logread -f -e aether' for real-time logs"
}

# --- Passwall2 integration ----------------------------------------------
# Optional bridge to luci-app-passwall2. Lets operators turn off Passwall2's
# router-local (localhost) proxying, which competes with Aether for local
# traffic, and manage exactly one canonical Passwall2 socks node
# ("aether_node") pointing at Aether's SOCKS5 listener.

PW_CFG="passwall2"
PW_NODE="aether_node"

pw_installed() {
	$UCI -q show "$PW_CFG" >/dev/null 2>&1
}

pw_global_get() {
	$UCI -q get "${PW_CFG}.@global[0].$1" 2>/dev/null
}

# Sets PW_AE_HOST / PW_AE_PORT from aether.socks_listen.
pw_set_host_port() {
	local listen host
	listen="$(uci_get socks_listen)"
	[ -n "$listen" ] || listen="0.0.0.0:1819"
	host="${listen%:*}"
	case "$host" in
		0.0.0.0|'')  host=127.0.0.1 ;;
		':'|'::')    host='::1' ;;
		'['*']')     host='::1' ;;
	esac
	PW_AE_HOST="$host"
	PW_AE_PORT="${listen##*:}"
}

pw_node_sections() {
	$UCI -q show "$PW_CFG" 2>/dev/null |
		sed -n "s/^$PW_CFG\.\([^.]*\)=nodes$/\1/p"
}

# Loopback socks nodes are candidates for pointing at Aether.
pw_is_loopback_addr() {
	case "$1" in
		127.0.0.1|::1|localhost|0.0.0.0|'') return 0 ;;
		*) return 1 ;;
	esac
}

# A node belongs to this integration when its section name or remarks
# mention aether. Everything else is the operator's own configuration.
pw_is_aether_node() {
	case "${1}${2}" in
		*aether*|*Aether*|*AETHER*) return 0 ;;
		*) return 1 ;;
	esac
}

pw_print_conflict_fix() {
	local sec="$1"
	echo ""
	echo "Fix (pick one):"
	echo "  1. LuCI -> Services -> Passwall2 -> Nodes -> edit '$sec':"
	echo "     set Address=$PW_AE_HOST and Port=$PW_AE_PORT, then Save & Apply."
	echo "  2. Delete that node, apply, then run: aether-ctl passwall add-node"
}

do_passwall_status() {
	local sec proto addr prt remark first_sec
	local matched_count=0 conflict_count=0
	matched_nodes="" conflict_nodes="" conflict_names=""

	if ! pw_installed; then
		echo "passwall2_present=0"
		log_warn "Passwall2 config not found (is luci-app-passwall2 installed?)"
		return 1
	fi

	pw_set_host_port
	echo "passwall2_present=1"
	echo "passwall2_enabled=$(pw_global_get enabled)"
	echo "localhost_proxy=$(pw_global_get localhost_proxy)"
	echo "client_proxy=$(pw_global_get client_proxy)"
	echo "aether_socks_addr=${PW_AE_HOST}:${PW_AE_PORT}"

	for sec in $(pw_node_sections); do
		proto="$($UCI -q get "$PW_CFG.$sec.protocol" 2>/dev/null)"
		[ "$proto" = "socks" ] || continue
		addr="$($UCI -q get "$PW_CFG.$sec.address" 2>/dev/null)"
		pw_is_loopback_addr "$addr" || continue
		prt="$($UCI -q get "$PW_CFG.$sec.port" 2>/dev/null)"
		remark="$($UCI -q get "$PW_CFG.$sec.remarks" 2>/dev/null)"
		pw_is_aether_node "$sec" "$remark" || continue
		if [ "$addr" = "$PW_AE_HOST" ] && [ "$prt" = "$PW_AE_PORT" ]; then
			matched_count=$((matched_count + 1))
			matched_nodes="$matched_nodes $sec(${remark:-no-remarks})"
		else
			conflict_count=$((conflict_count + 1))
			conflict_nodes="$conflict_nodes $sec(${addr}:${prt}, remarks=${remark:-none})"
			conflict_names="$conflict_names $sec"
		fi
	done

	echo "node_found=$matched_count"
	echo "matched_nodes=$matched_nodes"
	echo "conflict_count=$conflict_count"
	echo "conflict_nodes=$conflict_nodes"
	echo "conflict_names=$conflict_names"

	log_key "Passwall2" "installed (global enabled=$(pw_global_get enabled))"
	log_key "Localhost Proxy" "$(pw_global_get localhost_proxy)"
	log_key "Client Proxy" "$(pw_global_get client_proxy)"
	log_key "Aether SOCKS" "${PW_AE_HOST}:${PW_AE_PORT}"
	if [ "$matched_count" -gt 0 ]; then
		log_key "Matching Nodes" "$matched_nodes"
	elif [ "$conflict_count" -gt 0 ]; then
		first_sec="${conflict_names# }"
		first_sec="${first_sec%% *}"
		log_key "Matching Nodes" "none"
		log_warn "Existing Aether node(s) point elsewhere:$conflict_nodes"
		pw_print_conflict_fix "$first_sec"
	else
		log_key "Matching Nodes" "none"
		log_warn "No Passwall2 socks node points at ${PW_AE_HOST}:${PW_AE_PORT} (fix: aether-ctl passwall add-node)"
	fi
	return 0
}

do_passwall_localhost() {
	local value="$1"
	case "$value" in
		on|1|yes|enable)   value=1 ;;
		off|0|no|disable)  value=0 ;;
		*)
			log_err "Usage: aether-ctl passwall localhost on|off"
			return 1
			;;
	esac
	if ! pw_installed; then
		log_err "Passwall2 config not found"
		return 1
	fi
	local pw_enabled
	pw_enabled="$(pw_global_get enabled)"
	# Never quote the value in "uci set key=value".
	$UCI set "${PW_CFG}.@global[0].localhost_proxy=$value"
	$UCI commit "$PW_CFG"
	if [ "$value" = "1" ]; then
		log_info "Passwall2 localhost_proxy set to 1"
	else
		log_info "Passwall2 localhost_proxy disabled (router-local traffic no longer proxied by Passwall2)"
	fi
	if [ "$pw_enabled" = "1" ] && [ -x /etc/init.d/passwall2 ]; then
		if /etc/init.d/passwall2 restart >/dev/null 2>&1; then
			log_info "Passwall2 restarted to apply"
		else
			log_warn "Could not restart Passwall2 automatically; restart it manually"
		fi
	fi
}

do_passwall_add_node() {
	local sec="$PW_NODE"
	local existing proto addr prt remark
	if ! pw_installed; then
		log_err "Passwall2 config not found"
		return 1
	fi
	if pw_node_sections | grep -Fxq "$sec" 2>/dev/null; then
		log_err "Passwall2 node '$sec' already exists; nothing to do"
		return 1
	fi
	pw_set_host_port
	# Never create a second Aether node. If any aether-marked loopback
	# socks node exists, tell the operator how to reconcile instead of
	# silently adding another entry.
	for existing in $(pw_node_sections); do
		proto="$($UCI -q get "$PW_CFG.$existing.protocol" 2>/dev/null)"
		[ "$proto" = "socks" ] || continue
		addr="$($UCI -q get "$PW_CFG.$existing.address" 2>/dev/null)"
		pw_is_loopback_addr "$addr" || continue
		prt="$($UCI -q get "$PW_CFG.$existing.port" 2>/dev/null)"
		remark="$($UCI -q get "$PW_CFG.$existing.remarks" 2>/dev/null)"
		pw_is_aether_node "$existing" "$remark" || continue
		if [ "$addr" = "$PW_AE_HOST" ] && [ "$prt" = "$PW_AE_PORT" ]; then
			log_err "Passwall2 node '$existing' already points at ${PW_AE_HOST}:${PW_AE_PORT}; nothing to do"
		else
			log_err "Passwall2 node '$existing' points at ${addr}:${prt} but Aether listens on ${PW_AE_HOST}:${PW_AE_PORT}"
			pw_print_conflict_fix "$existing"
		fi
		return 1
	done

	# Never quote values in "uci set key=value"; all values below are fixed
	# tokens without spaces so quoting is unnecessary.
	$UCI set "${PW_CFG}.${sec}=nodes"
	$UCI set "${PW_CFG}.${sec}.remarks=aether"
	$UCI set "${PW_CFG}.${sec}.type=Xray"
	$UCI set "${PW_CFG}.${sec}.protocol=socks"
	$UCI set "${PW_CFG}.${sec}.address=${PW_AE_HOST}"
	$UCI set "${PW_CFG}.${sec}.port=${PW_AE_PORT}"
	$UCI set "${PW_CFG}.${sec}.tls=0"
	$UCI set "${PW_CFG}.${sec}.transport=raw"
	$UCI set "${PW_CFG}.${sec}.tcp_fast_open=0"
	$UCI set "${PW_CFG}.${sec}.tcpMptcp=0"
	$UCI commit "$PW_CFG"
	log_info "Created Passwall2 node '$sec' -> socks ${PW_AE_HOST}:${PW_AE_PORT}"
	log_warn "Select '$sec' in Passwall2 (node or shunt rules) to route traffic through Aether"
}

do_passwall() {
	local action="${1:-status}"
	case "$action" in
		status)
			shift 2>/dev/null
			do_passwall_status "$@"
			;;
		localhost)
			do_passwall_localhost "${2:-}"
			;;
		add-node)
			do_passwall_add_node
			;;
		*)
			echo "Usage: aether-ctl passwall <status|localhost <on|off>|add-node>"
			return 1
			;;
	esac
}

case "${1:-}" in
	start)    do_start ;;
	stop)     do_stop ;;
	restart)  do_restart ;;
	status)   do_status ;;
	show)     do_show ;;
	set)      do_set "$2" "$3" ;;
	test)     do_test "$2" ;;
	check-ip|ip) do_check_ip ;;
	check-tor|tor-ip) do_check_tor ;;
	check-psiphon|psiphon-ip) do_check_psiphon ;;
	log)      do_log "$2" ;;
	passwall) shift; do_passwall "$@" ;;
	version)  shift; do_version "$@" ;;
	change-version) shift; do_change_version "$@" ;;
	update)   shift; do_update "$@" ;;
	auto-perf) do_auto_perf ;;
	help|--help|-h|*)
		echo "Aether OpenWrt Controller"
		echo ""
		echo "Usage: aether-ctl <command> [args]"
		echo ""
		echo "Commands:"
		echo "  start           Start Aether tunnel"
		echo "  stop            Stop Aether tunnel"
		echo "  restart         Restart Aether tunnel"
		echo "  status          Show running status and config"
		echo "  show            Show current configuration"
		echo "  set <opt> <val> Change a configuration option (bare 'set' lists options)"
		echo "  test <host>     Test connection through the tunnel"
		echo "  check-ip        Check public IP address, country, and ping"
		echo "  ip              Alias for check-ip"
		echo "  check-tor       Check Tor exit IP and IsTor status (v2.0.0+)"
		echo "  check-psiphon   Check the Psiphon exit IP (v2.1+)"
		echo "  log [lines]     Show Aether logs (default 50 lines)"
		echo "  passwall <cmd>  Passwall2 bridge: status | localhost on|off | add-node"
		echo "  version [change <tag> [opts]]  Show or change the Aether core version"
		echo "  change-version <tag> [opts]     Install a core version (v1.5.0+)"
		echo "  update [opts]                   Download current updater and reinstall"
		echo "  auto-perf                       Auto-detect router RAM and set recommended perf_profile"
		echo ""
		echo "Examples:"
		echo "  aether-ctl start"
		echo "  aether-ctl set protocol wg"
		echo "  aether-ctl set scan_mode ironclad"
		echo "  aether-ctl set obfuscation_profile aggressive"
		echo "  aether-ctl set command_mode manual"
		echo "  aether-ctl set custom_command '--bind 0.0.0.0:1819 --wg'"
		echo "  aether-ctl test google.com"
		echo "  aether-ctl check-ip"
		echo "  aether-ctl check-tor"
		echo "  aether-ctl set psiphon_mode tunnel"
		echo "  aether-ctl check-psiphon"
		echo "  aether-ctl set exit_loc '!IR,AZ,RU'"
		echo "  aether-ctl passwall status"
		echo "  aether-ctl passwall localhost off"
		echo "  aether-ctl passwall add-node"
		echo "  aether-ctl set enabled no"
		echo "  aether-ctl auto-perf"
		echo "  aether-ctl change-version v1.5.0 --start"
		echo "  aether-ctl update --version v1.6.0 --start"
		;;
esac
