#!/bin/sh /etc/rc.common
# Aether - censorship circumvention tunnel service
# UCI "enabled" controls the boot symlink only. Explicit start/stop actions
# always control the current runtime independently.

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/aether
RUNNER=/usr/bin/aether-run

# Aether identity files: missing = provision new; empty/invalid = fatal TOML error.
# MASQUE uses a sibling path (aether-masque.toml); wg/gool use the base path and
# gool also needs aether-secondary.toml. Older installers created empty stubs.
sanitize_identity_file() {
	local f="$1"
	[ -f "$f" ] || return 0
	if ! grep -q 'device_id' "$f" 2>/dev/null; then
		logger -t aether "Removing invalid identity stub (missing device_id): $f"
		rm -f "$f"
	fi
}

# Mirror Aether's derive_sibling_path: insert -<suffix> before the extension.
identity_sibling() {
	local base="$1" suffix="$2"
	local dir name
	dir="${base%/*}"
	name="${base##*/}"
	case "$name" in
		*.*) echo "${dir}/${name%.*}-${suffix}.${name##*.}" ;;
		*)   echo "${base}-${suffix}" ;;
	esac
}

# v1.6 introduced HTTP CONNECT, the MASQUE startup deadline, and core log
# controls. v1.7 added upstream proxy chaining (--upstream).
# v2.1 added Psiphon modes, exit-location pinning (--exit-loc), traffic
# stats (--stats), Tor relay sources (--tor-relays), and the Tor HTTP
# listener (--tor-http). v2.3 changed gool to a MASQUE-carried tunnel with
# --gool-classic selecting the older WARP-in-WARP, and added --gool-peer
# plus the verified scan mode.
# Newer core versions inherit the latest capability set until a later version
# receives an explicit compatibility profile here.
core_version() {
	"$PROG" --version 2>/dev/null | awk 'NR == 1 {
		for (i = 1; i <= NF; i++) {
			version = $i
			sub(/^v/, "", version)
			if (version ~ /^[0-9]+\.[0-9]+\.[0-9]+/) {
				print version
				exit
			}
		}
	}'
}

core_supports_v16() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 6 ] 2>/dev/null; }
}

core_supports_v17() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 7 ] 2>/dev/null; }
}

core_supports_v18() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 8 ] 2>/dev/null; }
}

core_supports_v19() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 9 ] 2>/dev/null; }
}

# v2 adds MASQUE-in-MASQUE, the QUIC v2 control, and optional Tor modes.
core_supports_v20() {
	local version="$1" major
	major="${version%%.*}"
	[ "$major" -ge 2 ] 2>/dev/null
}

# v2.1 adds Psiphon, --exit-loc, --stats, --tor-relays, and --tor-http.
core_supports_v21() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 2 ] 2>/dev/null ||
		{ [ "$major" -eq 2 ] 2>/dev/null && [ "$minor" -ge 1 ] 2>/dev/null; }
}

# v2.3 makes gool MASQUE-carried (--gool-classic is the old WARP-in-WARP),
# adds --gool-peer, and registers the verified scan mode.
core_supports_v23() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 2 ] 2>/dev/null ||
		{ [ "$major" -eq 2 ] 2>/dev/null && [ "$minor" -ge 3 ] 2>/dev/null; }
}

# Automatic performance profile from total RAM. Thresholds follow the
# measured RSS table in CLIENT-GUIDE.en.md (core 1.9.0, x86_64): peak RSS
# stays under the next-lower boundary with headroom for id-load spikes.
select_perf_profile() {
	local total_kb
	total_kb="$(awk '/^MemTotal/ {print $2}' /proc/meminfo 2>/dev/null)"
	case "$total_kb" in
		''|*[!0-9]*) echo "low"; return ;;
	esac
	if [ "$total_kb" -lt 262144 ]; then
		echo "low"
	elif [ "$total_kb" -lt 786432 ]; then
		echo "medium"
	else
		echo "high"
	fi
}

# Core v2's embedded Tor (Arti) refuses its persistent state unless every
# ancestor directory is root-owned and free of group/other write bits
# (fs-mistrust). OpenWrt images ship / and /etc owned by the firmware build
# UID, and tar overlays extracted as root reset their mode to the archived
# (Windows: 0777) value, so repair both when Tor is on.
fix_tor_state_owners() {
	local d out owner perms fixed
	for d in / /etc; do
		fixed=0
		out="$(ls -lad "$d" 2>/dev/null)"
		owner="$(echo "$out" | awk '{print $3}')"
		perms="$(echo "$out" | awk '{print $1}')"
		if [ -n "$owner" ] && [ "$owner" != "root" ] && [ "$owner" != "0" ]; then
			chown root:root "$d" 2>/dev/null && fixed=1
		fi
		case "$perms" in
			?????w*|????????w*) chmod 755 "$d" 2>/dev/null && fixed=1 ;;
		esac
		if [ "$fixed" -eq 1 ]; then
			logger -t aether "Repaired $d ownership/permissions for Tor state"
		fi
	done
}
# instance with respawn/logging, then start the data-plane watchdog.
finish_service_instances() {
	# Reset the crash counter after 30 seconds of healthy runtime. The old
	# one-hour threshold permanently stopped recovery after several unrelated
	# WireGuard/gool drops within an hour.
	procd_set_param respawn 30 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$watchdog_enabled" -eq 1 ] && [ -x /usr/bin/aether-watchdog ] &&
	   command -v curl >/dev/null 2>&1; then
		procd_open_instance "watchdog"
		procd_set_param command /usr/bin/aether-watchdog
		procd_set_param respawn 30 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}
start_service() {
	config_load aether

	local watchdog_enabled
	local protocol socks_listen http_proxy scan_mode ip_version obfuscation_profile
	local http2_mode h2_peer fragment_tls fragment_size fragment_delay peer
	local keepalive reconnect_secs validate_secs startup_secs quick_reconnect
	local no_data_check config_path log_level
	local no_profile_retry team access_id access_secret access_token
	local upstream_proxy perf_profile wiw_outer wiw_inner mim_outer mim_inner mim_peers
	local quic_v2 ech tor_mode tor_bind tor_dir tor_bridges masque_identity_path
	local tor_http tor_relays exit_loc stats
	local psiphon_mode psiphon_bind psiphon_http psiphon_region psiphon_shape
	local gool_carrier gool_peer
	local command_mode custom_command
	local manual_args
	local installed_version supports_v16 supports_v17 supports_v18 supports_v19 supports_v20
	local supports_v21 supports_v23

	installed_version="$(core_version)"
	if [ -z "$installed_version" ]; then
		logger -t aether "ERROR: could not determine installed Aether core version"
		echo "aether: cannot determine /usr/bin/aether version" >&2
		return 1
	fi
	if core_supports_v16 "$installed_version"; then
		supports_v16=1
	else
		supports_v16=0
	fi
	if core_supports_v17 "$installed_version"; then
		supports_v17=1
	else
		supports_v17=0
	fi
	if core_supports_v18 "$installed_version"; then
		supports_v18=1
	else
		supports_v18=0
	fi
	if core_supports_v19 "$installed_version"; then
		supports_v19=1
	else
		supports_v19=0
	fi
	if core_supports_v20 "$installed_version"; then
		supports_v20=1
	else
		supports_v20=0
	fi
	if core_supports_v21 "$installed_version"; then
		supports_v21=1
	else
		supports_v21=0
	fi
	if core_supports_v23 "$installed_version"; then
		supports_v23=1
	else
		supports_v23=0
	fi
	config_get protocol main protocol 'masque'
	config_get socks_listen main socks_listen '0.0.0.0:1819'
	config_get http_proxy main http_proxy ''
	config_get perf_profile main perf_profile 'low'
	config_get wiw_outer main wiw_outer ''
	config_get wiw_inner main wiw_inner ''
	config_get mim_outer main mim_outer ''
	config_get mim_inner main mim_inner ''
	config_get mim_peers main mim_peers ''
	config_get quic_v2 main quic_v2 '1'
	config_get ech main ech ''
	config_get tor_mode main tor_mode 'off'
	config_get tor_bind main tor_bind '127.0.0.1:1820'
	config_get tor_dir main tor_dir ''
	config_get tor_bridges main tor_bridges 'auto'
	config_get tor_http main tor_http ''
	config_get tor_relays main tor_relays 'auto'
	config_get exit_loc main exit_loc ''
	config_get stats main stats '0'
	config_get psiphon_mode main psiphon_mode 'off'
	config_get psiphon_bind main psiphon_bind '127.0.0.1:1821'
	config_get psiphon_http main psiphon_http ''
	config_get psiphon_region main psiphon_region ''
	config_get psiphon_shape main psiphon_shape 'auto'
	config_get gool_carrier main gool_carrier 'masque'
	config_get gool_peer main gool_peer ''
	config_get command_mode main command_mode 'generated'
	config_get custom_command main custom_command ''
	config_get upstream_proxy main upstream_proxy ''
	config_get scan_mode main scan_mode 'balanced'
	config_get ip_version main ip_version 'ipv4'
	config_get obfuscation_profile main obfuscation_profile 'firewall'
	config_get http2_mode main http2_mode '0'
	config_get h2_peer main h2_peer ''
	config_get fragment_tls main fragment_tls '0'
	config_get fragment_size main fragment_size '16-32'
	config_get fragment_delay main fragment_delay '2-10'
	config_get peer main peer ''
	config_get keepalive main keepalive '5'
	config_get reconnect_secs main reconnect_secs '2'
	config_get validate_secs main validate_secs '10'
	config_get startup_secs main startup_secs '30'
	config_get quick_reconnect main quick_reconnect '1'
	config_get no_data_check main no_data_check '0'
	config_get no_profile_retry main no_profile_retry '0'
	config_get config_path main config_path '/etc/aether/aether.toml'
	config_get log_level main log_level 'info'
	config_get team main team ''
	config_get access_id main access_id ''
	config_get access_secret main access_secret ''
	config_get access_token main access_token ''
	config_get_bool watchdog_enabled main watchdog_enabled 1

	# An explicitly disabled transport is the generated Psiphon-only mode:
	# keep the Aether core process as Psiphon's host, but do not start WARP.
	# Manual command mode remains an explicit operator override.
	if [ "$command_mode" != "manual" ] && [ "$protocol" = "disabled" ]; then
		if [ "$supports_v21" -ne 1 ]; then
			logger -t aether "ERROR: protocol=disabled requires Aether core v2.1.0 or newer"
			echo "aether: protocol=disabled requires Aether core v2.1.0 or newer" >&2
			return 1
		fi
		if [ "$psiphon_mode" != "only" ]; then
			logger -t aether "ERROR: protocol=disabled requires psiphon_mode=only"
			echo "aether: set psiphon_mode=only to use protocol=disabled" >&2
			return 1
		fi
		case "$tor_mode" in
			off|'') ;;
			*)
				logger -t aether "ERROR: protocol=disabled requires tor_mode=off"
				echo "aether: turn Tor off to use protocol=disabled" >&2
				return 1 ;;
		esac
	fi

	if { [ -n "$access_id" ] || [ -n "$access_secret" ] || [ -n "$access_token" ]; } &&
	   [ -z "$team" ]; then
		logger -t aether "ERROR: Zero Trust credentials require a team name"
		echo "aether: incomplete Zero Trust service-token configuration" >&2
		return 1
	fi
	if [ -n "$team" ] && [ -z "$access_token" ] &&
	   { [ -z "$access_id" ] || [ -z "$access_secret" ]; }; then
		logger -t aether "ERROR: Zero Trust requires an access token or service-token credentials"
		echo "aether: Zero Trust team needs access_token or access_id/access_secret" >&2
	    return 1
	fi
	local command="$PROG"
	if [ -x "$RUNNER" ]; then
		command="$RUNNER"
	elif [ -n "$team" ]; then
		logger -t aether "ERROR: Zero Trust launcher is missing: $RUNNER"
		return 1
	fi

	mkdir -p "$(dirname "$config_path")" 2>/dev/null
	# Drop empty stubs so all transports can provision; keep valid identity files.
	# MIM's inner identity is the secondary sibling of the MASQUE identity.
	masque_identity_path="$(identity_sibling "$config_path" masque)"
	sanitize_identity_file "$config_path"
	sanitize_identity_file "$(identity_sibling "$config_path" secondary)"
	sanitize_identity_file "$masque_identity_path"
	sanitize_identity_file "$(identity_sibling "$masque_identity_path" secondary)"

	procd_open_instance "core"
	procd_set_param command "$command"
	# Manual command mode: run the operator's exact arguments instead of the
	# generated flags. Still launched through aether-run so Zero Trust
	# secrets stay in the environment, never on the command line.
	if [ "$command_mode" = "manual" ]; then
		manual_args="$custom_command"
		# Accept the full command as shown in LuCI/ubus: drop a leading
		# binary path so it is never passed twice (which makes the core
		# dump --help in a crash loop).
		case "$manual_args" in
			"$RUNNER "*|"$PROG "*) manual_args="${manual_args#* }" ;;
			"$RUNNER"|"$PROG") manual_args="" ;;
		esac
		if [ -z "$manual_args" ]; then
			logger -t aether "Manual command mode with empty custom_command; falling back to generated flags"
		else
			local w had_f
			case "$-" in *f*) had_f=1 ;; *) had_f=0 ;; esac
			set -f
			for w in $manual_args; do
				procd_append_param command "$w"
			done
			[ "$had_f" -eq 0 ] && set +f
			case "$manual_args" in
				*--tor*) fix_tor_state_owners ;;
			esac
			logger -t aether "Starting Aether with manual command arguments: $manual_args"
			finish_service_instances
			return 0
		fi
	fi
	procd_append_param command --bind "$socks_listen"
	if [ -n "$http_proxy" ] && [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --http-proxy "$http_proxy"
	elif [ -n "$http_proxy" ]; then
		logger -t aether "Ignoring HTTP CONNECT proxy: Aether v$installed_version requires v1.6.0 or newer"
	fi
	if [ -n "$upstream_proxy" ] && [ "$supports_v17" -eq 1 ]; then
		procd_append_param command --upstream "$upstream_proxy"
	elif [ -n "$upstream_proxy" ]; then
		logger -t aether "Ignoring upstream proxy: Aether v$installed_version requires v1.7.0 or newer"
	fi
	procd_append_param command --config "$config_path"
	# Core v1.8+ resource profile: explicit UCI value wins; empty selects
	# automatically from total RAM (see select_perf_profile).
	if [ "$supports_v18" -eq 1 ]; then
		if [ -z "$perf_profile" ]; then
			perf_profile="$(select_perf_profile)"
			logger -t aether "auto-selected performance profile: $perf_profile"
		fi
		procd_append_param command --perf "$perf_profile"
	fi
	# Core v1.9+ dual-hop gool endpoints. Named hops are kept across
	# reconnects by the core; unnamed hops are scanned as before.
	# Core v2.3+ renamed the transport: --gool carries WARP over MASQUE and
	# any named --wiw-* endpoint would silently select the classic
	# WARP-in-WARP carrier. Pass classic endpoints only when the operator
	# chose the classic carrier (or on cores where classic is the only gool).
	if [ "$supports_v19" -eq 1 ] && [ "$protocol" = "gool" ]; then
		if [ "$supports_v23" -eq 1 ] && [ "$gool_carrier" != "classic" ]; then
			if [ -n "$wiw_outer" ] || [ -n "$wiw_inner" ]; then
				logger -t aether "Ignoring classic WARP-in-WARP endpoints: set gool_carrier=classic to use them on core v$installed_version"
			fi
		else
			[ -n "$wiw_outer" ] && procd_append_param command --wiw-outer "$wiw_outer"
			[ -n "$wiw_inner" ] && procd_append_param command --wiw-inner "$wiw_inner"
		fi
	fi
	# Core v2 MASQUE-in-MASQUE endpoints are separate from gool endpoints.
	if [ "$supports_v20" -eq 1 ] && [ "$protocol" = "mim" ]; then
		[ -n "$mim_outer" ] && procd_append_param command --mim-outer "$mim_outer"
		[ -n "$mim_inner" ] && procd_append_param command --mim-inner "$mim_inner"
		[ -n "$mim_peers" ] && procd_append_param command --mim-peers "$mim_peers"
	fi
	case "$protocol" in
		masque)
			procd_append_param command --masque
			case "$obfuscation_profile" in firewall|gfw|off) ;; *) obfuscation_profile=firewall ;; esac
			;;
		wg)
			procd_append_param command --wg
			case "$obfuscation_profile" in balanced|aggressive|light|off) ;; *) obfuscation_profile=balanced ;; esac
			;;
		gool)
			procd_append_param command --gool
			# Core v2.3+: --gool is MASQUE-carried by default;
			# --gool-classic restores the older WireGuard-in-WireGuard
			# carrier, and --gool-peer pins the inner WireGuard endpoint
			# of the MASQUE-carried tunnel.
			if [ "$supports_v23" -eq 1 ]; then
				if [ "$gool_carrier" = "classic" ]; then
					procd_append_param command --gool-classic
				elif [ -n "$gool_peer" ]; then
					procd_append_param command --gool-peer "$gool_peer"
				fi
			fi
			case "$obfuscation_profile" in balanced|aggressive|light|off) ;; *) obfuscation_profile=balanced ;; esac
			;;
		mim)
			[ "$supports_v20" -eq 1 ] || {
				logger -t aether "ERROR: MASQUE-in-MASQUE requires Aether core v2.0.0 or newer"
				procd_close_instance
				return 1
			}
			procd_append_param command --mim
			case "$obfuscation_profile" in firewall|gfw|off) ;; *) obfuscation_profile=firewall ;; esac
			;;
		disabled)
			# No Aether tunnel protocol; --psiphon-only is appended below.
			obfuscation_profile=off
			;;
		*)
			logger -t aether "ERROR: invalid protocol: $protocol"
			procd_close_instance
			return 1
			;;
	esac
	logger -t aether "Starting Aether core v$installed_version (protocol=$protocol, config=$config_path, obfuscation=$obfuscation_profile)"

	case "$scan_mode" in
		turbo|balanced|thorough|stealth|ironclad)
			procd_append_param command --scan "$scan_mode" ;;
		verified)
			# Core v2.1+ only: dial only edges measured to answer
			# connect-ip. Older cores would reject the value.
			if [ "$supports_v21" -eq 1 ]; then
				procd_append_param command --scan verified
			else
				logger -t aether "Ignoring scan_mode=verified: Aether v$installed_version requires v2.1.0 or newer; using balanced"
				procd_append_param command --scan balanced
			fi
			;;
	esac

	case "$ip_version" in
		ipv4)  procd_append_param command -4 ;;
		ipv6)  procd_append_param command -6 ;;
		both)  procd_append_param command --dual ;;
	esac

	# Core v2.1+ exit-country pinning and traffic stats logging. Both are
	# off unless configured, matching the core defaults.
	if [ "$supports_v21" -eq 1 ]; then
		[ -n "$exit_loc" ] && procd_append_param command --exit-loc "$exit_loc"
		[ "$stats" = "1" ] && procd_append_param command --stats
	elif [ -n "$exit_loc" ] || [ "$stats" = "1" ]; then
		logger -t aether "Ignoring exit_loc/stats: Aether v$installed_version requires v2.1.0 or newer"
	fi

	[ "$protocol" != "disabled" ] && [ -n "$obfuscation_profile" ] &&
		procd_append_param command --noize "$obfuscation_profile"
	if [ "$protocol" = "masque" ] || [ "$protocol" = "mim" ]; then
		[ "$http2_mode" = "1" ] && procd_append_param command --h2
		[ "$supports_v20" -eq 1 ] && [ "$quic_v2" = "0" ] &&
			procd_append_param command --no-quic-v2
		[ "$supports_v19" -eq 1 ] && [ -n "$ech" ] &&
			procd_append_param command --ech "$ech"
		[ -n "$h2_peer" ] && [ "$http2_mode" = "1" ] &&
			procd_append_param command --h2-peer "$h2_peer"
		if [ "$fragment_tls" = "1" ]; then
			procd_append_param command --fragment
			[ -n "$fragment_size" ] && procd_append_param command --fragment-size "$fragment_size"
			[ -n "$fragment_delay" ] && procd_append_param command --fragment-delay "$fragment_delay"
		fi
	fi
	[ -n "$peer" ] && procd_append_param command --peer "$peer"
	[ "$protocol" != "masque" ] && procd_append_param command --keepalive "$keepalive"
	# v1.5 documents these flags for MASQUE only. v1.6+ accepts the
	# integration's existing all-transport reconnect/validation behavior.
	if [ "$protocol" = "masque" ] || [ "$protocol" = "mim" ] || [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --reconnect-secs "$reconnect_secs"
		procd_append_param command --validate-secs "$validate_secs"
	fi
	if { [ "$protocol" = "masque" ] || [ "$protocol" = "mim" ]; } && [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --startup-secs "$startup_secs"
	fi
	[ "$protocol" != "masque" ] && [ "$no_profile_retry" = "1" ] &&
		procd_append_param command --no-profile-retry
	if [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --log-level "$log_level"
	fi
	[ "$quick_reconnect" = "1" ] && procd_append_param command --quick-reconnect
	[ "$quick_reconnect" = "0" ] && procd_append_param command --no-quick-reconnect
	[ "$no_data_check" = "1" ] && procd_append_param command --no-data-check
	if [ "$supports_v20" -eq 1 ]; then
		case "$tor_mode" in
			off|'') ;;
			tunnel) procd_append_param command --tor ;;
			reverse)
				[ "$protocol" = "masque" ] || {
					logger -t aether "ERROR: Tor reverse mode requires MASQUE"
					procd_close_instance
					return 1
				}
				procd_append_param command --tor-reverse ;;
			only) procd_append_param command --tor-only ;;
			*)
				logger -t aether "ERROR: invalid Tor mode: $tor_mode"
				procd_close_instance
				return 1 ;;
		esac
		if [ "$tor_mode" != "off" ] && [ -n "$tor_mode" ]; then
			fix_tor_state_owners
			if [ "$tor_mode" = "tunnel" ] || [ "$tor_mode" = "reverse" ]; then
				[ -n "$tor_bind" ] && procd_append_param command --tor-bind "$tor_bind"
			fi
			[ -n "$tor_dir" ] && procd_append_param command --tor-dir "$tor_dir"
			case "$tor_bridges" in
				on) procd_append_param command --tor-bridges ;;
				off) procd_append_param command --no-tor-bridges ;;
			esac
			if [ "$supports_v21" -eq 1 ]; then
				[ -n "$tor_http" ] && procd_append_param command --tor-http "$tor_http"
				case "$tor_relays" in
					''|auto) ;;
					only|off) procd_append_param command --tor-relays "$tor_relays" ;;
					*[!0-9]*)
						logger -t aether "Ignoring invalid tor_relays: $tor_relays (use auto/only/off or a count)" ;;
					*) procd_append_param command --tor-relays "$tor_relays" ;;
				esac
			fi
		fi
	fi
	# Core v2.1+ embedded Psiphon, mirroring the Tor mode structure.
	# psiphon-reverse dials the tunnel through Psiphon, which carries TCP
	# only, so like Tor reverse it requires MASQUE.
	if [ "$supports_v21" -eq 1 ]; then
		case "$psiphon_mode" in
			off|'') ;;
			tunnel) procd_append_param command --psiphon ;;
			reverse)
				[ "$protocol" = "masque" ] || {
					logger -t aether "ERROR: Psiphon reverse mode requires MASQUE"
					procd_close_instance
					return 1
				}
				procd_append_param command --psiphon-reverse ;;
			only) procd_append_param command --psiphon-only ;;
			*)
				logger -t aether "ERROR: invalid Psiphon mode: $psiphon_mode"
				procd_close_instance
				return 1 ;;
		esac
		if [ "$psiphon_mode" = "tunnel" ] || [ "$psiphon_mode" = "reverse" ]; then
			[ -n "$psiphon_bind" ] && procd_append_param command --psiphon-bind "$psiphon_bind"
		fi
		[ -n "$psiphon_http" ] && procd_append_param command --psiphon-http "$psiphon_http"
		[ -n "$psiphon_region" ] && procd_append_param command --psiphon-region "$psiphon_region"
		case "$psiphon_shape" in
			auto|'') ;;
			cdn|direct) procd_append_param command --psiphon-mode "$psiphon_shape" ;;
			*)
				logger -t aether "Ignoring invalid psiphon_shape: $psiphon_shape (use auto/cdn/direct)" ;;
		esac
	elif [ "$psiphon_mode" != "off" ] && [ -n "$psiphon_mode" ]; then
		logger -t aether "Ignoring psiphon_mode=$psiphon_mode: Aether v$installed_version requires v2.1.0 or newer"
	fi
	finish_service_instances
}

stop_service() {
	logger -t aether "Stopping Aether"
}

service_triggers() {
	procd_add_reload_trigger "aether"
}
