#!/bin/sh /etc/rc.common
# Aether - censorship circumvention tunnel service
# UCI "enabled" controls the boot symlink only. Explicit start/stop actions
# always control the current runtime independently.

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/aether
RUNNER=/usr/bin/aether-run

# Aether identity files: missing = provision new; empty/invalid = fatal TOML error.
# MASQUE uses a sibling path (aether-masque.toml); wg/gool use the base path and
# gool also needs aether-secondary.toml. Older installers created empty stubs.
sanitize_identity_file() {
	local f="$1"
	[ -f "$f" ] || return 0
	if ! grep -q 'device_id' "$f" 2>/dev/null; then
		logger -t aether "Removing invalid identity stub (missing device_id): $f"
		rm -f "$f"
	fi
}

# Mirror Aether's derive_sibling_path: insert -<suffix> before the extension.
identity_sibling() {
	local base="$1" suffix="$2"
	local dir name
	dir="${base%/*}"
	name="${base##*/}"
	case "$name" in
		*.*) echo "${dir}/${name%.*}-${suffix}.${name##*.}" ;;
		*)   echo "${base}-${suffix}" ;;
	esac
}

# v1.6 introduced HTTP CONNECT, the MASQUE startup deadline, and core log
# controls. v1.7 added upstream proxy chaining (--upstream).
# Newer core versions inherit the latest capability set until a later version
# receives an explicit compatibility profile here.
core_version() {
	"$PROG" --version 2>/dev/null | awk 'NR == 1 {
		for (i = 1; i <= NF; i++) {
			version = $i
			sub(/^v/, "", version)
			if (version ~ /^[0-9]+\.[0-9]+\.[0-9]+/) {
				print version
				exit
			}
		}
	}'
}

core_supports_v16() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 6 ] 2>/dev/null; }
}

core_supports_v17() {
	local version="$1" major minor rest
	major="${version%%.*}"
	rest="${version#*.}"
	minor="${rest%%.*}"
	[ "$major" -gt 1 ] 2>/dev/null ||
		{ [ "$major" -eq 1 ] 2>/dev/null && [ "$minor" -ge 7 ] 2>/dev/null; }
}

start_service() {
	config_load aether

	local watchdog_enabled
	local protocol socks_listen http_proxy scan_mode ip_version obfuscation_profile
	local http2_mode h2_peer fragment_tls fragment_size fragment_delay peer
	local keepalive reconnect_secs validate_secs startup_secs quick_reconnect
	local no_data_check config_path log_level
	local no_profile_retry team access_id access_secret access_token
	local upstream_proxy
	local installed_version supports_v16 supports_v17

	installed_version="$(core_version)"
	if [ -z "$installed_version" ]; then
		logger -t aether "ERROR: could not determine installed Aether core version"
		echo "aether: cannot determine /usr/bin/aether version" >&2
		return 1
	fi
	if core_supports_v17 "$installed_version"; then
		supports_v17=1
	else
		supports_v17=0
	fi
	if core_supports_v16 "$installed_version"; then
		supports_v16=1
	else
		supports_v16=0
	fi

	config_get protocol main protocol 'masque'
	config_get socks_listen main socks_listen '0.0.0.0:1819'
	config_get http_proxy main http_proxy ''
	config_get upstream_proxy main upstream_proxy ''
	config_get scan_mode main scan_mode 'balanced'
	config_get ip_version main ip_version 'ipv4'
	config_get obfuscation_profile main obfuscation_profile 'firewall'
	config_get http2_mode main http2_mode '0'
	config_get h2_peer main h2_peer ''
	config_get fragment_tls main fragment_tls '0'
	config_get fragment_size main fragment_size '16-32'
	config_get fragment_delay main fragment_delay '2-10'
	config_get peer main peer ''
	config_get keepalive main keepalive '5'
	config_get reconnect_secs main reconnect_secs '2'
	config_get validate_secs main validate_secs '10'
	config_get startup_secs main startup_secs '30'
	config_get quick_reconnect main quick_reconnect '1'
	config_get no_data_check main no_data_check '0'
	config_get no_profile_retry main no_profile_retry '0'
	config_get config_path main config_path '/etc/aether/aether.toml'
	config_get log_level main log_level 'info'
	config_get team main team ''
	config_get access_id main access_id ''
	config_get access_secret main access_secret ''
	config_get access_token main access_token ''
	config_get_bool watchdog_enabled main watchdog_enabled 1

	if { [ -n "$access_id" ] || [ -n "$access_secret" ] || [ -n "$access_token" ]; } &&
	   [ -z "$team" ]; then
		logger -t aether "ERROR: Zero Trust credentials require a team name"
		echo "aether: incomplete Zero Trust service-token configuration" >&2
		return 1
	fi
	if [ -n "$team" ] && [ -z "$access_token" ] &&
	   { [ -z "$access_id" ] || [ -z "$access_secret" ]; }; then
		logger -t aether "ERROR: Zero Trust requires an access token or service-token credentials"
		echo "aether: Zero Trust team needs access_token or access_id/access_secret" >&2
	    return 1
	fi
	local command="$PROG"
	if [ -x "$RUNNER" ]; then
		command="$RUNNER"
	elif [ -n "$team" ]; then
		logger -t aether "ERROR: Zero Trust launcher is missing: $RUNNER"
		return 1
	fi

	mkdir -p "$(dirname "$config_path")" 2>/dev/null
	# Drop empty stubs so wg/gool can provision; keep valid identity files.
	sanitize_identity_file "$config_path"
	sanitize_identity_file "$(identity_sibling "$config_path" secondary)"
	sanitize_identity_file "$(identity_sibling "$config_path" masque)"

	procd_open_instance "core"
	procd_set_param command "$command"
	procd_append_param command --bind "$socks_listen"
	if [ -n "$http_proxy" ] && [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --http-proxy "$http_proxy"
	elif [ -n "$http_proxy" ]; then
		logger -t aether "Ignoring HTTP CONNECT proxy: Aether v$installed_version requires v1.6.0 or newer"
	fi
	if [ -n "$upstream_proxy" ] && [ "$supports_v17" -eq 1 ]; then
		procd_append_param command --upstream "$upstream_proxy"
	elif [ -n "$upstream_proxy" ]; then
		logger -t aether "Ignoring upstream proxy: Aether v$installed_version requires v1.7.0 or newer"
	fi
	procd_append_param command --config "$config_path"
	case "$protocol" in
		masque)
			procd_append_param command --masque
			case "$obfuscation_profile" in firewall|gfw|off) ;; *) obfuscation_profile=firewall ;; esac
			;;
		wg)
			procd_append_param command --wg
			case "$obfuscation_profile" in balanced|aggressive|light|off) ;; *) obfuscation_profile=balanced ;; esac
			;;
		gool)
			procd_append_param command --gool
			case "$obfuscation_profile" in balanced|aggressive|light|off) ;; *) obfuscation_profile=balanced ;; esac
			;;
		*)
			logger -t aether "ERROR: invalid protocol: $protocol"
			procd_close_instance
			return 1
			;;
	esac
	logger -t aether "Starting Aether core v$installed_version (protocol=$protocol, config=$config_path, obfuscation=$obfuscation_profile)"

	case "$scan_mode" in
		turbo|balanced|thorough|stealth|ironclad)
			procd_append_param command --scan "$scan_mode" ;;
	esac

	case "$ip_version" in
		ipv4)  procd_append_param command -4 ;;
		ipv6)  procd_append_param command -6 ;;
		both)  procd_append_param command --dual ;;
	esac

	[ -n "$obfuscation_profile" ] && procd_append_param command --noize "$obfuscation_profile"
	if [ "$protocol" = "masque" ]; then
		[ "$http2_mode" = "1" ] && procd_append_param command --h2
		[ -n "$h2_peer" ] && [ "$http2_mode" = "1" ] &&
			procd_append_param command --h2-peer "$h2_peer"
		if [ "$fragment_tls" = "1" ]; then
			procd_append_param command --fragment
			[ -n "$fragment_size" ] && procd_append_param command --fragment-size "$fragment_size"
			[ -n "$fragment_delay" ] && procd_append_param command --fragment-delay "$fragment_delay"
		fi
	fi
	[ -n "$peer" ] && procd_append_param command --peer "$peer"
	[ "$protocol" != "masque" ] && procd_append_param command --keepalive "$keepalive"
	# v1.5 documents these flags for MASQUE only. v1.6+ accepts the
	# integration's existing all-transport reconnect/validation behavior.
	if [ "$protocol" = "masque" ] || [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --reconnect-secs "$reconnect_secs"
		procd_append_param command --validate-secs "$validate_secs"
	fi
	if [ "$protocol" = "masque" ] && [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --startup-secs "$startup_secs"
	fi
	[ "$protocol" != "masque" ] && [ "$no_profile_retry" = "1" ] &&
		procd_append_param command --no-profile-retry
	if [ "$supports_v16" -eq 1 ]; then
		procd_append_param command --log-level "$log_level"
	fi
	[ "$quick_reconnect" = "1" ] && procd_append_param command --quick-reconnect
	[ "$quick_reconnect" = "0" ] && procd_append_param command --no-quick-reconnect
	[ "$no_data_check" = "1" ] && procd_append_param command --no-data-check
	# Reset the crash counter after 30 seconds of healthy runtime. The old
	# one-hour threshold permanently stopped recovery after several unrelated
	# WireGuard/gool drops within an hour.
	procd_set_param respawn 30 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$watchdog_enabled" -eq 1 ] && [ -x /usr/bin/aether-watchdog ] &&
	   command -v curl >/dev/null 2>&1; then
		procd_open_instance "watchdog"
		procd_set_param command /usr/bin/aether-watchdog
		procd_set_param respawn 30 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

stop_service() {
	logger -t aether "Stopping Aether"
}

service_triggers() {
	procd_add_reload_trigger "aether"
}
